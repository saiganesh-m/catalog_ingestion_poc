# JEV API Credentials
# Replace with your actual live JEV API key if available.
# If left empty, the application will automatically run in clearly labeled MOCK mode.
JEV_API_KEY=

# JEV API Endpoint (requests go to {JEV_API_BASE_URL}/systemone)
JEV_API_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest

# Where JEV answers come from:
#   auto - live JEV when a key is set; if the call fails, a clearly labelled mock is used and the reason reported
#   live - live JEV only; a failed call is an error (use this to prove the real integration)
#   mock - never call the network (offline demos)
JEV_MODE=auto

# Per-attempt timeout (seconds) and retries for transient errors (408, 429, 5xx, network)
JEV_TIMEOUT_SECONDS=10
JEV_MAX_RETRIES=2

# Save every live request/response to output/jev_evidence/ (API key redacted)
JEV_SAVE_EVIDENCE=true

# Database URL
# Default is local SQLite. To switch to PostgreSQL, use:
# DATABASE_URL=postgresql://username:password@localhost:5432/catalog_db
DATABASE_URL=sqlite:///catalog.db

# Minimum confidence threshold for automated 'ready' status (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.80

# Supported Currencies (comma-separated ISO codes)
# Easily extensible - add any valid ISO 4217 currency codes
SUPPORTED_CURRENCIES=USD,EUR,GBP,INR,CAD,AUD,JPY,CHF,SGD,CNY

